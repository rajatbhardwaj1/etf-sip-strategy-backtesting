# Virtualenv
.venv/
venv/
ENV/

# Byte-compiled
__pycache__/
*.py[cod]
*$py.class

# Generated reports — rebuilt by main.py, and large
reports/
*.html
# ...except the published docs, which are the point of GitHub Pages.
!docs/
!docs/*.html

# Backtest outputs — regenerated on every run
sip_strategy_trades.csv
mf_tilt_trades.csv
*_trades.csv

# OS / editor
.DS_Store
.ipynb_checkpoints/
.ruff_cache/
.pytest_cache/
.mypy_cache/

# Credentials — this repo is public; nothing of the sort belongs here, and an
# accidental `git add .` must never sweep one in. The live trading credentials
# live in the private strategy-automation repo.
*.yaml
*.yml
*.env
.env*
*.pem
*.key
config.*
secrets.*
